#!/usr/bin/env ruby


#from PIL import Image
#import numpy as np

#import gvxrPython3 as gvxr

# Create an OpenGL context
puts "Create an OpenGL context"
gvxr.createWindow();
gvxr.setWindowSize(512, 512);


# Set up the beam
puts "Set up the beam"
gvxr.setSourcePosition(-40.0,  0.0, 0.0, "cm");
gvxr.usePointSource();
#gvxr.useParallelBeam();
gvxr.setMonoChromatic(0.08, "MeV", 1000);

# Set up the detector
puts "Set up the detector";
gvxr.setDetectorPosition(10.0, 0.0, 0.0, "cm");
gvxr.setDetectorUpVector(0, 1, 0);
gvxr.setDetectorNumberOfPixels(640, 320);
gvxr.setDetectorPixelSize(0.5, 0.5, "mm");

# Load the data
puts "Load the data";
gvxr.loadSceneGraph("@CMAKE_CURRENT_BINARY_DIR@/welsh-dragon-small.stl", "mm");

for label in gvxr.getMeshLabelSet():
    puts "Move ", label, " to the centre";
    gvxr.moveToCentre(label);
    
    #puts "Move the mesh to the center";
    #gvxr.moveToCenter(label);
    
    puts "Set ", label, "'s Hounsfield unit";
    gvxr.setHU(label, 1000)


# Compute an X-ray image
puts "Compute an X-ray image";
gvxr.disableArtefactFiltering();
# Not working anymore gvxr.enableArtefactFilteringOnGPU();
# Not working anymore gvxr.enableArtefactFilteringOnCPU();
x_ray_image = gvxr.computeXRayImage();

# Save the last image into a file
puts "Save the last image into a file";
gvxr.saveLastXRayImage();
gvxr.saveLastLBuffer();

# Retrieve the image in Numpy's 2D array format
#np_image = np.array(x_ray_image);

# Normalise the image between 0 and 255 (this is for PIL)
#np_normalised_image = (255 * (np_image-np_image.min())/np_image.max()).astype(np.int8);

# Convert the Numpy array into a PIL image
#img = Image.fromarray(np_normalised_image.astype(np.ubyte));

# Save the PIL image
#img.save('my.png')

# Show the image
#img.show()

# Display the 3D scene (no event loop)
gvxr.displayScene();


# Display the 3D scene (no event loop)
# Run an interactive loop 
# (can rotate the 3D scene and zoom-in)
# Keys are:
# Q/Escape: to quit the event loop (does not close the window)
# B: display/hide the X-ray beam
# W: display the polygon meshes in solid or wireframe
# N: display the X-ray image in negative or positive
# H: display/hide the X-ray detector
gvxr.renderLoop();
