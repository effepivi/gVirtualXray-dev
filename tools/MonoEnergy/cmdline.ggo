version "1.1.0"
package "gVirtualXRay"
purpose "Command line tool to simulate an X-ray projection using a monochromatic beam."
description "See http://gvirtualxray.sourceforge.net/"
versiontext "(c) by Dr Franck P. Vidal (franck.p.vidal@fpvidal.net), http://www.fpvidal.net/, Sept 2016, 2016, version 1.1, BSD 3-Clause License"

# Options

option "energy"      e "Energy (in keV)" float required
option "source"      s "Source position (in cm), takes exactly 3 float values separated by commas"   multiple(3) required float
option "detector"    d "Detector position (in cm), takes exactly 3 float values separated by commas" multiple(3) required float
option "up"          u "Detector up vector, takes exactly 3 float values separated by commas" multiple(3) required float
option "shape"       - "Shape of the beam (point source, or parallel beam" optional string default="point"
option "pixels"      p "Number of pixels in the detector, takes exactly 2 int values separated by commas"   multiple(2) required int
option "resolution"  r "Pixel size (in cm)"   required float
option "output"      o "Name of the output file" string required
option "geometries"  g "Details about the scanned objects (filenale.stl,HU)" multiple(2-) required string
