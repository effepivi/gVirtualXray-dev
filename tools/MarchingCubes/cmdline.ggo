version "1.1.0"
package "gVirtualXRay"
purpose "Command line tool to extract an iso-surface using the Marchin Cubes algorithm."
description "See http://gvirtualxray.sourceforge.net/"
versiontext "(c) by Dr Franck P. Vidal (franck.p.vidal@fpvidal.net), http://www.fpvidal.net/, Oct 2016, 2016, version 1.1, BSD 3-Clause License"

# Options

option "input"       i "Input volume" required string
option "output"      o "Output triangular mesh file" required string
option "threshold"   t "Iso-value(s)" multiple(1-2) required double
option "gui"         g "Display the iso-surface using OpenGL" flag off

