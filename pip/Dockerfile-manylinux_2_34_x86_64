# set base image (host OS)
FROM quay.io/pypa/manylinux_2_34_x86_64

# Install RPMs
RUN yum clean all && yum -y update
RUN yum install -y \
    figlet \
    libGL-devel libGLU-devel \
    mesa-libEGL-devel \
    mesa-libgbm-devel \
    libXcursor-devel \
    libXi-devel \
    libXinerama-devel \
    libXrandr-devel \
    libfontenc-devel \
    libXaw-devel \
    libXcomposite-devel \
    libXdmcp-devel \
    libXtst-devel \
    libxkbfile-devel \
    libXres-devel \
    libXScrnSaver-devel \
    xcb-util-wm-devel \
    xcb-util-image-devel \
    xcb-util-keysyms-devel \
    xcb-util-renderutil-devel \
    libXdamage-devel \
    libXxf86vm-devel \
    libXv-devel \
    xcb-util-devel \
    libuuid-devel \
    xcb-util-cursor-devel \
    doxygen \
    python-sphinx \
    python-pip \
    python-sphinx_rtd_theme

RUN python3 -m pip install     sphinx_book_theme
RUN python3 -m pip install     conan

